\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces T1, v1.2 Decision A: router $\times $ audit at default $P=0.25$, $\pi =1$; 1000 rounds, 20 seeds (means). All routers use identity+length checks and \texttt  {trust\_feedback=false}. $^{*}$: significant decrease vs.\ same-router/learner $a=0$, same-seed paired bootstrap ($B=10{,}000$), two-sided $p$, 95\% percentile CIs (Appendix\nonbreakingspace \ref {app:decision-a}), merged 84-test Decision-A Holm family, $\alpha =0.05$. Stored zero raw values mean $p_{\mathrm  {raw}}<2\times 10^{-4}$ (two-sided resolution $2/B$); stored zero Holm values have bound $\le 84\cdot 2/B=0.0168$, printed $\le 0.017$. $^{\dagger }$: $a=0.05$ is the upper edge of frozen $a^*(P=0.25)=[0.044,0.050]$. Below-$a^*$ rows are not counted toward result 1; individual significant cells remain marked. Not comparable with v1.0 audit arms.}}{7}{table.caption.53}\protected@file@percent }
\newlabel{tab:t1}{{5}{7}{T1, v1.2 Decision A: router $\times $ audit at default $P=0.25$, $\pi =1$; 1000 rounds, 20 seeds (means). All routers use identity+length checks and \texttt {trust\_feedback=false}. $^{*}$: significant decrease vs.\ same-router/learner $a=0$, same-seed paired bootstrap ($B=10{,}000$), two-sided $p$, 95\% percentile CIs (Appendix~\ref {app:decision-a}), merged 84-test Decision-A Holm family, $\alpha =0.05$. Stored zero raw values mean $p_{\mathrm {raw}}<2\times 10^{-4}$ (two-sided resolution $2/B$); stored zero Holm values have bound $\le 84\cdot 2/B=0.0168$, printed $\le 0.017$. $^{\dagger }$: $a=0.05$ is the upper edge of frozen $a^*(P=0.25)=[0.044,0.050]$. Below-$a^*$ rows are not counted toward result 1; individual significant cells remain marked. Not comparable with v1.0 audit arms}{table.caption.53}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces T2 at 40 sellers, 20 seeds, $L=0$ (mean [95\% CI]): $\mathrm  {E}$ and $\mathrm  {Q}$ for PILOT, StageRoute, and the D3 reference ($a=0.1$), with tail-trade runs (StageRoute / PILOT / D3). $\mathrm  {Q}$ is the simple mean of $q_{\mathrm  {swap}}$, $q_{\mathrm  {theft}}$, $q_{\mathrm  {downgrade}}$. D3 values are constant in $\pi $ by construction (not a finding).}}{7}{table.caption.56}\protected@file@percent }
\newlabel{tab:t2}{{6}{7}{T2 at 40 sellers, 20 seeds, $L=0$ (mean [95\% CI]): $\Emet $ and $\Qmet $ for PILOT, StageRoute, and the D3 reference ($a=0.1$), with tail-trade runs (StageRoute / PILOT / D3). $\Qmet $ is the simple mean of $q_{\mathrm {swap}}$, $q_{\mathrm {theft}}$, $q_{\mathrm {downgrade}}$. D3 values are constant in $\pi $ by construction (not a finding)}{table.caption.56}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Buyer exposure $\mathrm  {E}$ (a) and seller intent $\mathrm  {Q}$ (b) vs.\ reveal probability $\pi $ at 40 sellers. Lines are means over $n=20$ seeds; bands are 95\% paired-bootstrap CIs (10,000 resamples). The five audit arms share one colour and differ by line style. $\pi $ axis: symlog, linear below 0.08. $\mathrm  {Q}$ markers: solid 17--20/20 tail-trade runs; half-filled 12--13/20 (audits, just identifiable); hollow 0/20 (cheapest). Audit and fixed-router curves are flat in $\pi $ by construction and are not reported as a finding.}}{8}{figure.caption.57}\protected@file@percent }
\newlabel{fig:t2}{{2}{8}{Buyer exposure $\Emet $ (a) and seller intent $\Qmet $ (b) vs.\ reveal probability $\pi $ at 40 sellers. Lines are means over $n=20$ seeds; bands are 95\% paired-bootstrap CIs (10,000 resamples). The five audit arms share one colour and differ by line style. $\pi $ axis: symlog, linear below 0.08. $\Qmet $ markers: solid 17--20/20 tail-trade runs; half-filled 12--13/20 (audits, just identifiable); hollow 0/20 (cheapest). Audit and fixed-router curves are flat in $\pi $ by construction and are not reported as a finding}{figure.caption.57}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces A2 filter control, 40 sellers, $\pi =1$, seeds 0--19, paired (mean [95\% CI]). Viol.\ ON $=0$ for every method. Fill-rate off$-$on differences are all Holm-n.s.\ (not shown). D3 OFF is \texttt  {fixed\_audit\_a0.10} with \texttt  {--no-compliance-filter}. Audit filter-off $\mathrm  {Q}$ omitted (1/20 tail trades, not identifiable).}}{8}{table.caption.59}\protected@file@percent }
\newlabel{tab:a2}{{7}{8}{A2 filter control, 40 sellers, $\pi =1$, seeds 0--19, paired (mean [95\% CI]). Viol.\ ON $=0$ for every method. Fill-rate off$-$on differences are all Holm-n.s.\ (not shown). D3 OFF is \texttt {fixed\_audit\_a0.10} with \texttt {--no-compliance-filter}. Audit filter-off $\Qmet $ omitted (1/20 tail trades, not identifiable)}{table.caption.59}{}}
